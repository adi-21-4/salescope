# Copy to backend/.env and fill in values for local dev.

DATABASE_URL=postgresql+psycopg://insights:insights@localhost:5432/insights_picker
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=["http://localhost:5173"]

# Used from M4 onward (AI insights / NL query box) — not required for M1-M3.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
